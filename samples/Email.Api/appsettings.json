{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*",

  "EmailApi": {
    "DefaultFrom": "DoNotReply@REPLACE-WITH-YOUR-DOMAIN.azurecomm.net",
    "DefaultFromName": "Email POC"
  },

  "Email": {
    "DefaultProvider": "Console",
    "FallbackProviders": [],
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelayMilliseconds": 500
    },
    "MaxTotalAttachmentBytes": 10485760,
    "MaxRecipients": 50,

    "AzureAcs": {
      "ConnectionString": "",
      "WaitForCompletion": true
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UserName": "",
      "Password": "",
      "Security": "StartTls"
    }
  }
}
